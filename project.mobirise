        "mainFont": "Roboto",
        "display1Font": "Arvo",
        "display1Size": 4.5,
        "display2Font": "Arvo",
        "display2Size": 2.2,
        "display5Font": "Arvo",
        "display5Size": 1.8,
        "display7Font": "Rubik",
        "display7Size": 1.1,
        "display4Font": "Roboto",
        "display4Size": 0.9,
        "isRoundedButtons": false,
        "isScrollToTopButton": false,
